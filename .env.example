# ---------------------------------------------------------------
# Variáveis NEXT_PUBLIC_* são embutidas no build.
# Na Railway, defina-as ANTES do build (Variables do serviço).
# Alterou alguma? Faça um novo deploy.
# ---------------------------------------------------------------

# --- Institucional -------------------------------------------------
# Nome da empresa exibido no header, footer, SEO e mensagens
NEXT_PUBLIC_COMPANY_NAME="THD Solutions"
# URL pública final, sem barra no final (usada em canonical, Open Graph, sitemap e robots)
NEXT_PUBLIC_SITE_URL="https://www.thdsolutions.com.br"
# E-mail comercial (opcional — se vazio, não é exibido)
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- WhatsApp comercial (obrigatório) ------------------------------
# Somente dígitos: DDI + DDD + número. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
# Texto de exibição no footer (opcional). Se vazio, é formatado a partir do número.
NEXT_PUBLIC_WHATSAPP_DISPLAY=""
# "true" acrescenta um código de origem (utm_source / medium / campaign) ao fim da mensagem
NEXT_PUBLIC_WHATSAPP_INCLUDE_ATTRIBUTION="false"

# --- Rastreamento (todos opcionais) --------------------------------
# Modo recomendado: apenas o GTM; GA4 e Google Ads configurados dentro do GTM.
NEXT_PUBLIC_GTM_ID=""

# Modo direto (usado SOMENTE se NEXT_PUBLIC_GTM_ID estiver vazio)
NEXT_PUBLIC_GA4_ID=""
# ID da conta do Google Ads, ex.: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Rótulo da conversão principal (envio do formulário)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""
# Rótulo da conversão secundária (cliques no WhatsApp, soluções e parceria)
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=""
